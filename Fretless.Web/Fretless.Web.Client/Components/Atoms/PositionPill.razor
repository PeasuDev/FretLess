@namespace Fretless.Web.Client.Components.Atoms

<div class="position-pill position-pill--@Variant">
    <span class="position-pill__label">@Label</span>
    <div class="position-pill__chips">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
