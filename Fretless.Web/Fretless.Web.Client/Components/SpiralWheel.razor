@using System.Text.Encodings.Web
@using System.Text.Json
@using Fretless.Web.Client.Models
@inject IJSRuntime JS
@inject MidiService Midi
@inject AudioInputNoteService AudioInput
@inject InstrumentConnectionService InstrumentConnections
@implements IAsyncDisposable

<div class="spiral-wheel-container">
    <div class="spiral-wheel-area">

    <div class="spiral-key-selector" aria-label="Chart key selector">
        <label for="chart-key-select">Key</label>
        <select id="chart-key-select" class="spiral-control spiral-control--key-select" @bind="SelectedKey" aria-label="Select key">
            <option value=""></option>
            @foreach (var key in AvailableKeys)
            {
                <option value="@key">@key</option>
            }
        </select>

        <label for="chart-scale-select">Scale</label>
        <select id="chart-scale-select" class="spiral-control spiral-control--scale-select" @bind="SelectedScale" aria-label="Select scale">
            <option value=""></option>
            @foreach (var scale in AvailableScaleNames)
            {
                <option value="@scale">@scale</option>
            }
        </select>

        @if (!string.IsNullOrWhiteSpace(SelectedScale))
        {
            <button class="spiral-play-scale-btn"
                    @onclick="PlaySelectedScaleAsync"
                    disabled="@(!CanPlaySelectedScale)"
                    title="Play Scale"
                    aria-label="Play Scale">
                <span aria-hidden="true">🔊</span>
                <span>Play Scale</span>
            </button>
        }

        @if (TryGetSelectedScaleNoteLabels(out var selectedScaleNoteLabels))
        {
            <div class="spiral-scale-notes" aria-label="Notes in selected scale">
                @foreach (var note in selectedScaleNoteLabels)
                {
                    var isPlaying = IsSemitonePlaying(KeyLabelToChromaticSemitone(note));
                    var isRoot = !string.IsNullOrWhiteSpace(_selectedKey)
                        && KeyLabelToChromaticSemitone(note) == KeyLabelToChromaticSemitone(_selectedKey);
                    <ScaleNoteChip Note="@note" Variant="wheel" IsRoot="isRoot" IsPlaying="isPlaying" />
                }
            </div>
        }
    </div>

    <svg @ref="_svgRef"
         viewBox="@_viewBox"
         xmlns="http://www.w3.org/2000/svg"
         class="spiral-svg"
         preserveAspectRatio="xMidYMid meet"
         role="img"
         aria-label="Subdivision-aware zooming spiral foundation">

        <defs>
            <radialGradient id="spiralBg" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#111111" stop-opacity="1" />
                <stop offset="100%" stop-color="#000000" stop-opacity="1" />
            </radialGradient>
            <filter id="keyShadow" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="4" stdDeviation="7" flood-color="#000000" flood-opacity="1" />
            </filter>
            <filter id="centerHubShadow" x="-40%" y="-40%" width="180%" height="180%">
                <feDropShadow dx="0" dy="5" stdDeviation="10" flood-color="#000000" flood-opacity="1" />
            </filter>
        </defs>

        <rect x="-500" y="-500" width="1000" height="1000" fill="url(#spiralBg)" />

        @{
            var surfaceBlend = SurfaceBlend;
            var arcBlend = 1.0 - surfaceBlend;
            var layerSeparatorBlend = OvertoneLayerSeparatorBlend;
            var seamFadeBlend = SmoothStep(0.18, 1.0, layerSeparatorBlend);
            var segments = BuildSegments(arcBlend, seamFadeBlend);
            var surfaceSlices = BuildSolidSurfaceSlices();
            var keySubdivisionIndex = KeySubdivisionIndex;
            var graphRotationDegrees = _graphRotationDegrees;
            var hasSelectedNotes = _selectedNotes.Count > 0;
            var nonSelectedSliceOpacity = _selectedNotes.Count switch
            {
                0 => 1.0,
                1 => 0.82,
                _ => 0.38
            };
            var surfaceSliceOpacity = 1.0 - seamFadeBlend;
            var surfacePointerEvents = surfaceSliceOpacity <= 0.001 ? "none" : "auto";
            var segmentOpacity = seamFadeBlend;
            var segmentPointerEvents = segmentOpacity <= 0.001 ? "none" : "auto";
            var ringStroke = (0.55 / _zoom).I();
            var separatorStroke = (2.2 / _zoom).I();
            var layerSeparatorOpacity = layerSeparatorBlend.I();
            var dashArray = $"{(2.0 / _zoom).I()} {(7.0 / _zoom).I()}";
            var surfaceLabelOpacity = (1.0 - seamFadeBlend) * 0.95;
            var overtoneLabelOpacity = seamFadeBlend * 0.9;
            var showSelectedNotesAsWhite = string.IsNullOrWhiteSpace(_selectedKey) && string.IsNullOrWhiteSpace(_selectedScale);
        }
        <g class="spiral-rotation-layer" transform="rotate(@graphRotationDegrees.I())">
        <g style="pointer-events:@surfacePointerEvents" opacity="@surfaceSliceOpacity.I()">
                @foreach (var slice in surfaceSlices)
                {
                    var sliceSelected = IsSubdivisionSelected(slice.SubdivisionIndex);
                    var isKeySlice = slice.SubdivisionIndex == keySubdivisionIndex;
                    var isNotInScale = IsNoteOutsideSelectedScale(slice.SubdivisionIndex);
                    var isPlayingScaleNote = IsSemitonePlaying(ToChromaticSemitone(slice.SubdivisionIndex));
                    var sliceIsBlocked = isNotInScale && !sliceSelected;
                    var sliceOpacity = isPlayingScaleNote ? 1.0 : sliceSelected ? 1.0 : (isNotInScale ? 0.3 : nonSelectedSliceOpacity);
                    var sliceFill = isPlayingScaleNote ? PlayingIndicatorFill(ToChromaticSemitone(slice.SubdivisionIndex)) : isKeySlice || (showSelectedNotesAsWhite && sliceSelected) ? "#ffffff" : slice.Color;
                    <g class="spiral-segment spiral-note @(sliceSelected ? "spiral-note--selected" : null) @(isPlayingScaleNote ? "spiral-note--playing" : null)"
                       @onclick="() => HandleNoteClickAsync(slice.SubdivisionIndex, null)"
                       style="cursor:@(sliceIsBlocked ? "not-allowed" : "pointer")">
                        <path d="@slice.Path" fill="@sliceFill" stroke="@(isPlayingScaleNote ? "#ffffff" : "none")" stroke-width="@(isPlayingScaleNote ? (3.0 / _zoom).I() : "0")" opacity="@sliceOpacity.I()" filter="@(isKeySlice ? "url(#keyShadow)" : null)" />
                    </g>
                }
            </g>

            <g opacity="@segmentOpacity.I()" style="pointer-events:@segmentPointerEvents">
                @foreach (var segment in segments)
                {
                    var segSelected = IsSegmentSelected(segment.SubdivisionIndex, segment.Cycle);
                    var isKeySegment = segment.SubdivisionIndex == keySubdivisionIndex;
                    var isNotInScale = IsNoteOutsideSelectedScale(segment.SubdivisionIndex);
                    var isPlayingScaleNote = IsSemitonePlaying(ToChromaticSemitone(segment.SubdivisionIndex));
                    var segmentIsBlocked = isNotInScale && !segSelected;
                    var segmentNodeOpacity = isPlayingScaleNote ? 1.0 : segSelected ? 1.0 : (isNotInScale ? 0.3 : nonSelectedSliceOpacity);
                    var segmentFill = isPlayingScaleNote ? "#00e5ff" : isKeySegment || (showSelectedNotesAsWhite && segSelected) ? "#ffffff" : segment.Color;
                    <g class="spiral-segment spiral-note @(segSelected ? "spiral-note--selected" : null) @(isPlayingScaleNote ? "spiral-note--playing" : null)"
                       @onclick="() => HandleNoteClickAsync(segment.SubdivisionIndex, segment.Cycle)"
                       style="cursor:@(segmentIsBlocked ? "not-allowed" : "pointer")">
                        <path d="@segment.MorphPath"
                              fill="@segmentFill"
                              stroke="@(isPlayingScaleNote ? "#ffffff" : "none")"
                              stroke-width="@(isPlayingScaleNote ? (3.0 / _zoom).I() : "0")"
                              opacity="@segmentNodeOpacity.I()"
                              filter="@(isKeySegment ? "url(#keyShadow)" : null)" />
                    </g>
                }
            </g>

            <g style="pointer-events:none">
                @if (surfaceSliceOpacity > 0.001)
                {
                    foreach (var slice in surfaceSlices.Where(s => IsSubdivisionSelected(s.SubdivisionIndex)))
                    {
                        var selectionOverlayFill = showSelectedNotesAsWhite ? "#ffffff" : "rgba(255,215,0,0.18)";
                        var selectionOverlayStroke = showSelectedNotesAsWhite ? "#ffffff" : "#FFD700";
                        var selectionOverlayOpacity = showSelectedNotesAsWhite ? "1" : surfaceSliceOpacity.I();
                        <path d="@slice.Path" fill="@selectionOverlayFill" stroke="@selectionOverlayStroke" stroke-width="@((2.5 / _zoom).I())" stroke-linejoin="round" opacity="@selectionOverlayOpacity" />
                    }
                }

                @if (segmentOpacity > 0.001)
                {
                    foreach (var segment in segments.Where(s => IsSegmentSelected(s.SubdivisionIndex, s.Cycle)))
                    {
                        var selectionOverlayFill = showSelectedNotesAsWhite ? "#ffffff" : "rgba(255,215,0,0.18)";
                        var selectionOverlayStroke = showSelectedNotesAsWhite ? "#ffffff" : "#FFD700";
                        var selectionOverlayOpacity = showSelectedNotesAsWhite ? "1" : segmentOpacity.I();
                        <path d="@segment.MorphPath" fill="@selectionOverlayFill" stroke="@selectionOverlayStroke" stroke-width="@((2.5 / _zoom).I())" stroke-linejoin="round" opacity="@selectionOverlayOpacity" />
                    }
                }
            </g>



            <circle cx="0" cy="0" r="@CenterHubRadius.I()" fill="@(keySubdivisionIndex >= 0 ? "#ffffff" : "#000000")" filter="@(keySubdivisionIndex >= 0 ? "url(#centerHubShadow)" : null)" />

            @* MIDI active note highlights — rotated with the wheel *@
            @if (_midiActiveSemitones.Count > 0)
            {
                <g style="pointer-events:none">
                    @foreach (var semitone in _midiActiveSemitones)
                    {
                        var subIdx = SemitoneToSubdivisionIndex(semitone);
                        @foreach (var slice in surfaceSlices.Where(s => s.SubdivisionIndex == subIdx))
                        {
                            <path d="@slice.Path" fill="rgba(0,229,255,0.35)" stroke="#00e5ff" stroke-width="@((3.0 / _zoom).I())" stroke-linejoin="round" />
                        }
                        @foreach (var seg in segments.Where(s => s.SubdivisionIndex == subIdx))
                        {
                            <path d="@seg.MorphPath" fill="rgba(0,229,255,0.35)" stroke="#00e5ff" stroke-width="@((3.0 / _zoom).I())" stroke-linejoin="round" />
                        }
                    }
                </g>
            }

            @* Labels counter-rotated so text stays upright *@
            @if (TryBuildScaleDegreeLabels(out var scaleDegreeLabels))
            {
                var degreeLabelSize = ReadableWheelLabelSize(11.5, MinDegreeLabelSize);
                foreach (var degree in scaleDegreeLabels)
                {
                    @SvgTextUpright(degree.X, degree.Y, degreeLabelSize,
                        "fill:#f5f5f5;font-family:'Helvetica Neue',sans-serif;font-weight:800;letter-spacing:0.03em;pointer-events:none;opacity:0.92",
                        degree.Text, -graphRotationDegrees)
                }
            }

            @if (surfaceLabelOpacity > 0.001)
            {
                var baseLabelSize = ReadableWheelLabelSize(13.5, MinSurfaceLabelSize);
                foreach (var label in BuildSurfaceLabels(segments))
                {
                    var isSelected = IsSubdivisionSelected(label.SubdivisionIndex);
                    var labelFill = "#111111";
                    var labelSize = isSelected ? baseLabelSize * 1.22 : baseLabelSize;
                    @SvgTextUpright(label.X, label.Y, labelSize,
                        $"fill:{labelFill};font-family:'Helvetica Neue',sans-serif;font-weight:800;letter-spacing:0.01em;pointer-events:none;opacity:{surfaceLabelOpacity.I()}",
                        label.Text, -graphRotationDegrees)
                }
            }

            @if (overtoneLabelOpacity > 0.001)
            {
                var baseLabelSize = ReadableWheelLabelSize(8.5, MinOvertoneLabelSize);
                foreach (var segment in segments)
                {
                    var isSelected = IsSegmentSelected(segment.SubdivisionIndex, segment.Cycle);
                    var labelFill = "#111111";
                    var labelSize = isSelected ? baseLabelSize * 1.22 : baseLabelSize;
                    @SvgTextUpright(segment.MidX, segment.MidY, labelSize,
                        $"fill:{labelFill};font-family:'Helvetica Neue',sans-serif;font-weight:700;pointer-events:none;opacity:{overtoneLabelOpacity.I()}",
                        segment.Label, -graphRotationDegrees)
                }
            }
        </g>

        @* Center hub key label — fixed at origin, always upright *@
        @if (keySubdivisionIndex >= 0)
        {
            var centerLabelSize = ReadableWheelLabelSize(22.0, MinCenterLabelSize);
            @SvgText(0, 0, centerLabelSize,
                "fill:#111111;font-family:'Helvetica Neue',sans-serif;font-weight:900;letter-spacing:0.02em;pointer-events:none",
                SubdivisionRootLabel(keySubdivisionIndex))
        }
    </svg>

    </div><!-- /.spiral-wheel-area -->

    @if (_isResizingRightPanel)
    {
        <div class="spiral-panel-resize-capture"
             @onpointermove="ResizeRightPanel"
             @onpointerup="EndRightPanelResize"
             @onpointerleave="EndRightPanelResize"
             @onpointermove:preventDefault="true"
             @onpointerup:preventDefault="true">
        </div>
    }

    <button type="button"
            class="spiral-panel-resizer"
            title="Resize widget viewer"
            aria-label="Resize widget viewer"
            @onpointerdown="BeginRightPanelResize"
            @onpointerdown:preventDefault="true">
    </button>

    <div class="spiral-right-panel-stack" style="@RightPanelStyle" aria-label="Scale and note analysis panels">
        <section class="spiral-instrument-overlay-panel" aria-label="Current scale on guitar and piano">
            @{
                var overlaySemitones = GetInstrumentOverlaySemitones();
                var overlayRoot = GetOverlayRootSemitone();
                var hideNonScaleFretboardNotes = !string.IsNullOrWhiteSpace(_selectedScale) && GetSelectedScaleNotes() is not null;
                var hasSelectedOverlayPositionRange = TryGetSelectedOverlayPositionRange(out var overlayPositionStartFret, out var overlayPositionEndFret);
            }

            <div class="spiral-instrument-overlay-stack">
                @if (!string.IsNullOrWhiteSpace(_connectedInstrumentName))
                {
                    <ConnectedInstrumentSignal InstrumentName="@_connectedInstrumentName"
                                               NoteLabel="@CurrentInputNoteLabel"
                                               NoteDetail="@CurrentInputDetail"
                                               SignalStatus="@CurrentSignalStatus"
                                               GainStatus="@_gainStatus"
                                               GainStatusDetail="@_gainStatusDetail"
                                               @ref="_connectedInstrumentSignal" />
                }

                @{
                    var firstEmptyInstrumentSlot = InstrumentSlots.IndexOf(InstrumentType.None);
                }

                @for (var slotIdx = 0; slotIdx < InstrumentSlots.Count; slotIdx++)
                {
                    var slot = slotIdx;
                    var instrument = InstrumentSlots[slot];

                    if (instrument == InstrumentType.None)
                    {
                        if (slot != firstEmptyInstrumentSlot)
                        {
                            continue;
                        }

                        <InstrumentVisualAidSlot CanAddGuitar="@(!InstrumentSlots.Contains(InstrumentType.Guitar))"
                                                 CanAddPiano="@(!InstrumentSlots.Contains(InstrumentType.Piano))"
                                                 AddGuitar="() => SetInstrumentSlot(slot, InstrumentType.Guitar)"
                                                 AddPiano="() => SetInstrumentSlot(slot, InstrumentType.Piano)" />
                    }
                    else if (instrument == InstrumentType.Guitar)
                    {
                        <InstrumentOverlayCard>
                            <InstrumentOverlayHeader Title="Guitar fretboard">
                                    <button class="spiral-tuning-setup-btn @(_showTuningSetup ? "active" : null)"
                                            @onclick="ToggleTuningSetup"
                                            title="Configure strings and tuning">
                                        @_currentTuning.Name
                                    </button>
                                    <IconButton Icon="⚙"
                                                Variant="settings"
                                                Active="@(_openInstrumentSettingsSlot == slot)"
                                                Title="Guitar display settings"
                                                OnClick="() => ToggleInstrumentSettings(slot)" />
                                    <IconButton Icon="✕"
                                                Variant="remove"
                                                Title="Remove instrument"
                                                OnClick="() => SetInstrumentSlot(slot, InstrumentType.None)" />
                            </InstrumentOverlayHeader>

                            @if (_openInstrumentSettingsSlot == slot)
                            {
                                <InstrumentDisplaySettingsPanel ShowNoteNames="@_showGuitarNoteNames"
                                                                ShowNoteNamesChanged="OnShowGuitarNoteNamesChanged"
                                                                ShowFretNumbersOption="true"
                                                                ShowFretNumbers="@_showGuitarFretNumbers"
                                                                ShowFretNumbersChanged="OnShowGuitarFretNumbersChanged" />
                            }

                            @if (_showTuningSetup)
                            {
                                <TuningSelector Tuning="_currentTuning"
                                                TuningChanged="OnTuningChanged"
                                                OnDone="OnTuningDone"
                                                Inline="true" />
                            }

                            @{
                                var tuningStrings = _currentTuning.MidiNotes;
                                var stringCount = tuningStrings.Length;
                                var fretboardHeight = 14 + stringCount * 16 + 8;
                                var fretboardBottom = fretboardHeight - 8;
                                var fretboardViewBox = $"0 0 330 {fretboardHeight}";
                                var showScaleBoxes = TryGetSelectedScaleDegrees(out var overlayScaleDegrees);
                            }
                            <div class="spiral-fretboard-frame">
                                <svg viewBox="@fretboardViewBox" class="spiral-mini-fretboard" role="img" aria-label="Selected notes on guitar fretboard">
                                    <rect x="0" y="0" width="330" height="@fretboardHeight" rx="8" fill="transparent" />

                                    @if (_showGuitarFretNumbers)
                                    {
                                        for (var fret = 1; fret <= OverlayFretCount; fret++)
                                        {
                                            var x = 20 + (fret - 0.5) * 24;
                                            @SvgText(x, 7, 6.2, "pointer-events:none;font-family:'Helvetica Neue',sans-serif;fill:rgba(255,255,255,0.72);font-weight:800", fret.ToString())
                                        }
                                    }

                                    @for (var fret = 0; fret <= OverlayFretCount; fret++)
                                    {
                                        var x = 20 + fret * 24;
                                        var isNut = fret == 0;
                                        <line x1="@x" y1="14" x2="@x" y2="@fretboardBottom" stroke="@(isNut ? "#e8e8c8" : "#c0a060")" stroke-width="@((isNut ? 4.0 : 1.2).I())" />
                                    }

                                    @for (var stringIndex = 0; stringIndex < stringCount; stringIndex++)
                                    {
                                        var y = 22 + (stringCount - 1 - stringIndex) * 16;
                                        var openMidi = tuningStrings[stringIndex];
                                        var openSemitone = openMidi % 12;
                                        <line x1="20" y1="@y" x2="308" y2="@y" stroke="#d4c078" stroke-width="@((1.0 + (stringCount - 1 - stringIndex) * 0.2).I())" />

                                        for (var fret = 0; fret <= OverlayFretCount; fret++)
                                        {
                                            var semitone = (openSemitone + fret) % 12;

                                            if (hasSelectedOverlayPositionRange
                                                && (fret < overlayPositionStartFret || fret > overlayPositionEndFret))
                                            {
                                                continue;
                                            }

                                            var isHighlighted = overlaySemitones.Contains(semitone);
                                            var isPlayingScaleNote = IsGuitarPositionPlaying(openMidi, fret, semitone);
                                            if (hideNonScaleFretboardNotes && !isHighlighted && !isPlayingScaleNote)
                                            {
                                                continue;
                                            }

                                            var cx = fret == 0 ? 10 : 20 + (fret - 0.5) * 24;
                                            var isRoot = !string.IsNullOrWhiteSpace(_selectedKey) && overlayRoot >= 0 && semitone == overlayRoot;
                                            var dotFill = isPlayingScaleNote ? PlayingIndicatorFill(semitone) : isRoot ? "#ffd700" : isHighlighted ? "#ffffff" : "#555555";
                                            var dotOpacity = isPlayingScaleNote ? "1" : isRoot ? "0.98" : isHighlighted ? "1" : "0.25";
                                            var dotStroke = isPlayingScaleNote ? "#ffffff" : "none";
                                            var dotStrokeWidth = isPlayingScaleNote ? "1.8" : "0";
                                            var noteFill = isRoot || isHighlighted ? "#111111" : "#ffffff";
                                            var noteOpacity = isRoot ? "0.95" : isHighlighted ? "1" : "0.62";
                                            var noteLabel = ChromaticSemitoneLabel(semitone);
                                            var clickSemitone = semitone;
                                            <g style="cursor:pointer"
                                               @onclick="async () => await HandleNoteClickAsync(SemitoneToSubdivisionIndex(clickSemitone), null)">
                                                <circle cx="@cx" cy="@y" r="@(isPlayingScaleNote ? "8.4" : _showGuitarNoteNames ? "7" : "5.2")"
                                                        fill="@dotFill" opacity="@dotOpacity" stroke="@dotStroke" stroke-width="@dotStrokeWidth" />
                                                @if (_showGuitarNoteNames)
                                                {
                                                    @SvgText(cx, y, 5.1, $"pointer-events:none;font-family:'Helvetica Neue',sans-serif;fill:{noteFill};font-weight:900;opacity:{noteOpacity}", noteLabel)
                                                }
                                            </g>
                                        }
                                    }
                                </svg>
                            </div>

                            @if (showScaleBoxes)
                            {
                                <PositionPill Label="Positions" Variant="compact">
                                    <RomanNumeralButton Numeral="all"
                                                        Variant="compact"
                                                        Active="@(_selectedOverlayScaleDegree is null)"
                                                        OnClick="() => SelectOverlayScalePosition(null)" />
                                    @foreach (var position in overlayScaleDegrees)
                                    {
                                        var degree = position.Degree;
                                        <RomanNumeralButton Numeral="@RomanNumeral(position.Degree)"
                                                            Variant="compact"
                                                            Active="@(_selectedOverlayScaleDegree == degree)"
                                                            OnClick="() => SelectOverlayScalePosition(degree)" />
                                    }
                                </PositionPill>
                            }
                        </InstrumentOverlayCard>
                    }
                    else if (instrument == InstrumentType.Piano)
                    {
                        <InstrumentOverlayCard>
                            <InstrumentOverlayHeader Title="Piano keyboard">
                                    <IconButton Icon="⚙"
                                                Variant="settings"
                                                Active="@(_openInstrumentSettingsSlot == slot)"
                                                Title="Piano display settings"
                                                OnClick="() => ToggleInstrumentSettings(slot)" />
                                    <IconButton Icon="✕"
                                                Variant="remove"
                                                Title="Remove instrument"
                                                OnClick="() => SetInstrumentSlot(slot, InstrumentType.None)" />
                            </InstrumentOverlayHeader>

                            @if (_openInstrumentSettingsSlot == slot)
                            {
                                <InstrumentDisplaySettingsPanel ShowNoteNames="@_showPianoNoteNames"
                                                                ShowNoteNamesChanged="OnShowPianoNoteNamesChanged" />
                            }
                            <KeyboardView HighlightedSemitones="overlaySemitones"
                                          RootSemitone="@(string.IsNullOrWhiteSpace(_selectedKey) || overlayRoot < 0 ? null : (int?)overlayRoot)"
                                          PlayingSemitones="@CurrentlyPlayingSemitones"
                                          PlayingFillFor="@PlayingIndicatorFill"
                                          ShowLabels="_showPianoNoteNames"
                                          UseDarkLabelsForUnhighlightedKeys="@(!string.IsNullOrWhiteSpace(_selectedScale) && GetSelectedScaleNotes() is not null)"
                                          OctaveCount="2"
                                          OnKeyClicked="OnKeyboardKeyClicked" />
                        </InstrumentOverlayCard>
                    }
                }
            </div><!-- /.spiral-instrument-overlay-stack -->
        </section>
    </div><!-- /.spiral-right-panel-stack -->

</div><!-- /.spiral-wheel-container -->

