@using System.Text.Encodings.Web
@using System.Text.Json
@using Fretless.Web.Client.Models
@inject IJSRuntime JS
@inject MidiService Midi
@inject AudioInputNoteService AudioInput
@inject InstrumentConnectionService InstrumentConnections
@implements IAsyncDisposable

<div class="spiral-wheel-container">
    <div class="spiral-wheel-area">

    <div class="spiral-key-selector" aria-label="Chart key selector">
        <label for="chart-key-select">Key</label>
        <select id="chart-key-select" class="spiral-control spiral-control--key-select" @bind="SelectedKey" aria-label="Select key">
            <option value=""></option>
            @foreach (var key in AvailableKeys)
            {
                <option value="@key">@key</option>
            }
        </select>

        <label for="chart-scale-select">Scale</label>
        <select id="chart-scale-select" class="spiral-control spiral-control--scale-select" @bind="SelectedScale" aria-label="Select scale">
            <option value=""></option>
            @foreach (var scale in AvailableScaleNames)
            {
                <option value="@scale">@scale</option>
            }
        </select>

        @if (!string.IsNullOrWhiteSpace(SelectedScale))
        {
            <button class="spiral-play-scale-btn"
                    @onclick="PlaySelectedScaleAsync"
                    disabled="@(!CanPlaySelectedScale)"
                    title="Play Scale"
                    aria-label="Play Scale">
                <span aria-hidden="true">🔊</span>
                <span>Play Scale</span>
            </button>
        }

        @if (TryGetSelectedScaleNoteLabels(out var selectedScaleNoteLabels))
        {
            <div class="spiral-scale-notes" aria-label="Notes in selected scale">
                @foreach (var note in selectedScaleNoteLabels)
                {
                    var isPlaying = IsSemitonePlaying(KeyLabelToChromaticSemitone(note));
                    var isRoot = !string.IsNullOrWhiteSpace(_selectedKey)
                        && KeyLabelToChromaticSemitone(note) == KeyLabelToChromaticSemitone(_selectedKey);
                    <ScaleNoteChip Note="@note" Variant="wheel" IsRoot="isRoot" IsPlaying="isPlaying" />
                }
            </div>
        }
    </div>

    @{
        var surfaceBlend = SurfaceBlend;
        var arcBlend = 1.0 - surfaceBlend;
        var layerSeparatorBlend = OvertoneLayerSeparatorBlend;
        var seamFadeBlend = SmoothStep(0.18, 1.0, layerSeparatorBlend);
        var segments = BuildSegments(arcBlend, seamFadeBlend);
        var surfaceSlices = BuildSolidSurfaceSlices();
        var keySubdivisionIndex = KeySubdivisionIndex;
        var graphRotationDegrees = _graphRotationDegrees;
        var nonSelectedSliceOpacity = _selectedNotes.Count switch
        {
            0 => 1.0,
            1 => 0.82,
            _ => 0.38
        };
        var seamFade = seamFadeBlend;
        var surfaceSliceOpacity = 1.0 - seamFade;
        var segmentOpacity = seamFade;
        var surfaceLabelOpacity = (1.0 - seamFade) * 0.95;
        var overtoneLabelOpacity = seamFade * 0.9;
        var showSelectedNotesAsWhite = string.IsNullOrWhiteSpace(_selectedKey) && string.IsNullOrWhiteSpace(_selectedScale);
        TryBuildScaleDegreeLabels(out var scaleDegreeLabels);
        var surfaceLabels = BuildSurfaceLabels(segments).ToList();
        var degreeLabelSize = ReadableWheelLabelSize(11.5, MinDegreeLabelSize);
        var surfaceLabelSize = ReadableWheelLabelSize(13.5, MinSurfaceLabelSize);
        var overtoneLabelBaseSize = ReadableWheelLabelSize(8.5, MinOvertoneLabelSize);
        var centerLabelSize = ReadableWheelLabelSize(22.0, MinCenterLabelSize);
        var centerHubLabel = keySubdivisionIndex >= 0 ? SubdivisionRootLabel(keySubdivisionIndex) : null;
    }

    <SpiralView @ref="_spiralView"
                Segments="segments"
                SurfaceSlices="surfaceSlices"
                ScaleDegreeLabels="scaleDegreeLabels"
                SurfaceLabels="surfaceLabels"
                ViewBox="@_viewBox"
                KeySubdivisionIndex="keySubdivisionIndex"
                Rotation="graphRotationDegrees"
                Zoom="_zoom"
                SurfaceSliceOpacity="surfaceSliceOpacity"
                SegmentOpacity="segmentOpacity"
                SurfaceLabelOpacity="surfaceLabelOpacity"
                OvertoneLabelOpacity="overtoneLabelOpacity"
                NonSelectedSliceOpacity="nonSelectedSliceOpacity"
                ShowSelectedNotesAsWhite="showSelectedNotesAsWhite"
                MidiActiveSemitones="_midiActiveSemitones"
                CenterHubKeyLabel="@centerHubLabel"
                CenterLabelSize="centerLabelSize"
                DegreeLabelSize="degreeLabelSize"
                SurfaceLabelSize="surfaceLabelSize"
                OvertoneLabelBaseSize="overtoneLabelBaseSize"
                CenterHubRadius="CenterHubRadius"
                IsSubdivisionSelected="IsSubdivisionSelected"
                IsSegmentSelected="IsSegmentSelected"
                IsSemitonePlaying="IsSemitonePlaying"
                PlayingFillFor="PlayingIndicatorFill"
                IsNoteOutsideSelectedScale="IsNoteOutsideSelectedScale"
                ToChromaticSemitone="ToChromaticSemitone"
                SemitoneToSubdivisionIndex="SemitoneToSubdivisionIndex"
                OnNoteClicked="OnSpiralNoteClicked" />

    </div><!-- /.spiral-wheel-area -->

    @if (_isResizingRightPanel)
    {
        <div class="spiral-panel-resize-capture"
             @onpointermove="ResizeRightPanel"
             @onpointerup="EndRightPanelResize"
             @onpointerleave="EndRightPanelResize"
             @onpointermove:preventDefault="true"
             @onpointerup:preventDefault="true">
        </div>
    }

    <button type="button"
            class="spiral-panel-resizer"
            title="Resize widget viewer"
            aria-label="Resize widget viewer"
            @onpointerdown="BeginRightPanelResize"
            @onpointerdown:preventDefault="true">
    </button>

    <div class="spiral-right-panel-stack" style="@RightPanelStyle" aria-label="Scale and note analysis panels">
        <section class="spiral-instrument-overlay-panel" aria-label="Current scale on guitar and piano">
            @{
                var overlaySemitones = GetInstrumentOverlaySemitones();
                var overlayRoot = GetOverlayRootSemitone();
                var hideNonScaleFretboardNotes = !string.IsNullOrWhiteSpace(_selectedScale) && GetSelectedScaleNotes() is not null;
                var hasSelectedOverlayPositionRange = TryGetSelectedOverlayPositionRange(out var overlayPositionStartFret, out var overlayPositionEndFret);
            }

            <div class="spiral-instrument-overlay-stack">
                @if (!string.IsNullOrWhiteSpace(_connectedInstrumentName))
                {
                    <ConnectedInstrumentSignal InstrumentName="@_connectedInstrumentName"
                                               NoteLabel="@CurrentInputNoteLabel"
                                               NoteDetail="@CurrentInputDetail"
                                               SignalStatus="@CurrentSignalStatus"
                                               GainStatus="@_gainStatus"
                                               GainStatusDetail="@_gainStatusDetail"
                                               @ref="_connectedInstrumentSignal" />
                }

                @{
                    var firstEmptyInstrumentSlot = InstrumentSlots.IndexOf(InstrumentType.None);
                }

                @for (var slotIdx = 0; slotIdx < InstrumentSlots.Count; slotIdx++)
                {
                    var slot = slotIdx;
                    var instrument = InstrumentSlots[slot];

                    if (instrument == InstrumentType.None)
                    {
                        if (slot != firstEmptyInstrumentSlot)
                        {
                            continue;
                        }

                        <InstrumentVisualAidSlot CanAddGuitar="@(!InstrumentSlots.Contains(InstrumentType.Guitar))"
                                                 CanAddPiano="@(!InstrumentSlots.Contains(InstrumentType.Piano))"
                                                 AddGuitar="() => SetInstrumentSlot(slot, InstrumentType.Guitar)"
                                                 AddPiano="() => SetInstrumentSlot(slot, InstrumentType.Piano)" />
                    }
                    else if (instrument == InstrumentType.Guitar)
                    {
                        <InstrumentOverlayCard>
                            <InstrumentOverlayHeader Title="Guitar fretboard">
                                    <button class="spiral-tuning-setup-btn @(_showTuningSetup ? "active" : null)"
                                            @onclick="ToggleTuningSetup"
                                            title="Configure strings and tuning">
                                        @_currentTuning.Name
                                    </button>
                                    <IconButton Icon="⚙"
                                                Variant="settings"
                                                Active="@(_openInstrumentSettingsSlot == slot)"
                                                Title="Guitar display settings"
                                                OnClick="() => ToggleInstrumentSettings(slot)" />
                                    <IconButton Icon="✕"
                                                Variant="remove"
                                                Title="Remove instrument"
                                                OnClick="() => SetInstrumentSlot(slot, InstrumentType.None)" />
                            </InstrumentOverlayHeader>

                            @if (_openInstrumentSettingsSlot == slot)
                            {
                                <InstrumentDisplaySettingsPanel ShowNoteNames="@_showGuitarNoteNames"
                                                                ShowNoteNamesChanged="OnShowGuitarNoteNamesChanged"
                                                                ShowFretNumbersOption="true"
                                                                ShowFretNumbers="@_showGuitarFretNumbers"
                                                                ShowFretNumbersChanged="OnShowGuitarFretNumbersChanged" />
                            }

                            @if (_showTuningSetup)
                            {
                                <TuningSelector Tuning="_currentTuning"
                                                TuningChanged="OnTuningChanged"
                                                OnDone="OnTuningDone"
                                                Inline="true" />
                            }

                            @{
                                var showScaleBoxes = TryGetSelectedScaleDegrees(out var overlayScaleDegrees);
                            }
                            <div class="spiral-fretboard-frame">
                                <MiniFretboardView Tuning="_currentTuning"
                                                   FretCount="OverlayFretCount"
                                                   HighlightedSemitones="overlaySemitones"
                                                   RootSemitone="@(string.IsNullOrWhiteSpace(_selectedKey) || overlayRoot < 0 ? null : (int?)overlayRoot)"
                                                   IsPositionPlaying="IsGuitarPositionPlaying"
                                                   PlayingFillFor="PlayingIndicatorFill"
                                                   MinFret="@(hasSelectedOverlayPositionRange ? (int?)overlayPositionStartFret : null)"
                                                   MaxFret="@(hasSelectedOverlayPositionRange ? (int?)overlayPositionEndFret : null)"
                                                   HideNonHighlighted="hideNonScaleFretboardNotes"
                                                   ShowFretNumbers="_showGuitarFretNumbers"
                                                   ShowNoteNames="_showGuitarNoteNames"
                                                   OnSemitoneClicked="OnGuitarSemitoneClicked" />
                            </div>

                            @if (showScaleBoxes)
                            {
                                <PositionPill Label="Positions" Variant="compact">
                                    <RomanNumeralButton Numeral="all"
                                                        Variant="compact"
                                                        Active="@(_selectedOverlayScaleDegree is null)"
                                                        OnClick="() => SelectOverlayScalePosition(null)" />
                                    @foreach (var position in overlayScaleDegrees)
                                    {
                                        var degree = position.Degree;
                                        <RomanNumeralButton Numeral="@RomanNumeral(position.Degree)"
                                                            Variant="compact"
                                                            Active="@(_selectedOverlayScaleDegree == degree)"
                                                            OnClick="() => SelectOverlayScalePosition(degree)" />
                                    }
                                </PositionPill>
                            }
                        </InstrumentOverlayCard>
                    }
                    else if (instrument == InstrumentType.Piano)
                    {
                        <InstrumentOverlayCard>
                            <InstrumentOverlayHeader Title="Piano keyboard">
                                    <IconButton Icon="⚙"
                                                Variant="settings"
                                                Active="@(_openInstrumentSettingsSlot == slot)"
                                                Title="Piano display settings"
                                                OnClick="() => ToggleInstrumentSettings(slot)" />
                                    <IconButton Icon="✕"
                                                Variant="remove"
                                                Title="Remove instrument"
                                                OnClick="() => SetInstrumentSlot(slot, InstrumentType.None)" />
                            </InstrumentOverlayHeader>

                            @if (_openInstrumentSettingsSlot == slot)
                            {
                                <InstrumentDisplaySettingsPanel ShowNoteNames="@_showPianoNoteNames"
                                                                ShowNoteNamesChanged="OnShowPianoNoteNamesChanged" />
                            }
                            <KeyboardView HighlightedSemitones="overlaySemitones"
                                          RootSemitone="@(string.IsNullOrWhiteSpace(_selectedKey) || overlayRoot < 0 ? null : (int?)overlayRoot)"
                                          PlayingSemitones="@CurrentlyPlayingSemitones"
                                          PlayingFillFor="@PlayingIndicatorFill"
                                          ShowLabels="_showPianoNoteNames"
                                          UseDarkLabelsForUnhighlightedKeys="@(!string.IsNullOrWhiteSpace(_selectedScale) && GetSelectedScaleNotes() is not null)"
                                          OctaveCount="2"
                                          OnKeyClicked="OnKeyboardKeyClicked" />
                        </InstrumentOverlayCard>
                    }
                }
            </div><!-- /.spiral-instrument-overlay-stack -->
        </section>
    </div><!-- /.spiral-right-panel-stack -->

</div><!-- /.spiral-wheel-container -->

