@using System.Text.Encodings.Web
@inject IJSRuntime JS

<div class="spiral-wheel-container">
    <div class="spiral-key-selector" aria-label="Chart key selector">
        <label for="chart-key-select">Key</label>
        <select id="chart-key-select" class="spiral-control spiral-control--key-select" @bind="SelectedKey" aria-label="Select key">
            <option value=""></option>
            @foreach (var key in AvailableKeys)
            {
                <option value="@key">@key</option>
            }
        </select>

        <label for="chart-scale-select">Scale</label>
        <select id="chart-scale-select" class="spiral-control spiral-control--scale-select" @bind="SelectedScale" aria-label="Select scale">
            <option value=""></option>
            @foreach (var scale in AvailableScaleNames)
            {
                <option value="@scale">@scale</option>
            }
        </select>
    </div>

    <div class="spiral-toolbar" role="toolbar" aria-label="Spiral foundation controls">
        <button class="spiral-control" @onclick="ZoomOut" aria-label="Zoom out">−</button>
        <button class="spiral-control" @onclick="ResetZoom" aria-label="Reset to fully zoomed out view">R</button>
        <button class="spiral-control" @onclick="ZoomIn" aria-label="Zoom in">+</button>
        <span class="spiral-divider" aria-hidden="true"></span>
        <button class="spiral-control spiral-control--wide @(IsSurfaceView ? "active" : null)" @onclick="ShowSurface">Zoomed Out</button>
        <button class="spiral-control spiral-control--wide @(IsZoomedView ? "active" : null)" @onclick="ShowZoomedIn">Zoomed In</button>
        <button class="spiral-control spiral-control--wide" @onclick="PreviewShapeShrinkAsync" disabled="@_isPreviewing">Preview</button>
    </div>

    <svg @ref="_svgRef"
         viewBox="@_viewBox"
         xmlns="http://www.w3.org/2000/svg"
         class="spiral-svg @(_isDragging ? "dragging" : null)"
         @onwheel="OnWheel"
         @onpointerdown="OnPointerDown"
         @onpointermove="OnPointerMove"
         @onpointerup="OnPointerUp"
         @onpointerleave="OnPointerUp"
         preserveAspectRatio="xMidYMid meet"
         role="img"
         aria-label="Subdivision-aware zooming spiral foundation">

        <defs>
            <radialGradient id="spiralBg" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#1a1a2e" stop-opacity="1" />
                <stop offset="100%" stop-color="#0d0d1a" stop-opacity="1" />
            </radialGradient>
        </defs>

        <rect x="-500" y="-500" width="1000" height="1000" fill="url(#spiralBg)" />

        @{
            var surfaceBlend = SurfaceBlend;
            var arcBlend = 1.0 - surfaceBlend;
            var layerSeparatorBlend = OvertoneLayerSeparatorBlend;
            var seamFadeBlend = SmoothStep(0.18, 1.0, layerSeparatorBlend);
            var segments = BuildSegments(arcBlend, seamFadeBlend);
            var keySubdivisionIndex = KeySubdivisionIndex;
            var graphRotationDegrees = _graphRotationDegrees;
            var hasSelectedNotes = _selectedNotes.Count > 0;
            var nonSelectedSliceOpacity = _selectedNotes.Count switch
            {
                0 => 1.0,
                1 => 0.82,
                _ => 0.38
            };
            var surfaceSliceOpacity = 1.0 - seamFadeBlend;
            var surfacePointerEvents = surfaceSliceOpacity <= 0.001 ? "none" : "auto";
            var segmentOpacity = seamFadeBlend;
            var segmentPointerEvents = segmentOpacity <= 0.001 ? "none" : "auto";
            var ringStroke = (0.55 / _zoom).I();
            var separatorStroke = (2.2 / _zoom).I();
            var layerSeparatorOpacity = layerSeparatorBlend.I();
            var dashArray = $"{(2.0 / _zoom).I()} {(7.0 / _zoom).I()}";
            var surfaceLabelOpacity = (1.0 - seamFadeBlend) * 0.95;
            var overtoneLabelOpacity = seamFadeBlend * 0.9;
        }
        <g transform="rotate(@graphRotationDegrees.I())">
            <g style="pointer-events:@surfacePointerEvents" opacity="@surfaceSliceOpacity.I()">
                @foreach (var slice in BuildSolidSurfaceSlices())
                {
                    var sliceSelected = IsSubdivisionSelected(slice.SubdivisionIndex);
                    var isKeySlice = slice.SubdivisionIndex == keySubdivisionIndex;
                    var isNotInScale = IsNoteOutsideSelectedScale(slice.SubdivisionIndex);
                    var sliceIsBlocked = isNotInScale && !sliceSelected;
                    var sliceOpacity = sliceSelected ? 1.0 : (isNotInScale ? 0.3 : nonSelectedSliceOpacity);
                    <g class="spiral-segment spiral-note @(sliceSelected ? "spiral-note--selected" : null)"
                       @onclick="() => HandleNoteClickAsync(slice.SubdivisionIndex, null)"
                       style="cursor:@(sliceIsBlocked ? "not-allowed" : "pointer")">
                        <path d="@slice.Path" fill="@slice.Color" stroke="none" opacity="@sliceOpacity.I()" />
                        @if (sliceSelected)
                        {
                            <path d="@slice.Path" fill="rgba(255,215,0,0.18)" stroke="#FFD700" stroke-width="@(2.5 / _zoom)" stroke-linejoin="round" />
                        }
                    </g>
                }
            </g>

            <g opacity="@segmentOpacity.I()" style="pointer-events:@segmentPointerEvents">
                @foreach (var segment in segments)
                {
                    var segSelected = IsSegmentSelected(segment.SubdivisionIndex, segment.Cycle);
                    var isKeySegment = segment.SubdivisionIndex == keySubdivisionIndex;
                    var isNotInScale = IsNoteOutsideSelectedScale(segment.SubdivisionIndex);
                    var segmentIsBlocked = isNotInScale && !segSelected;
                    var segmentNodeOpacity = segSelected ? 1.0 : (isNotInScale ? 0.3 : nonSelectedSliceOpacity);
                    <g class="spiral-segment spiral-note @(segSelected ? "spiral-note--selected" : null)"
                       @onclick="() => HandleNoteClickAsync(segment.SubdivisionIndex, segment.Cycle)"
                       style="cursor:@(segmentIsBlocked ? "not-allowed" : "pointer")">
                        <path d="@segment.MorphPath"
                              fill="@segment.Color"
                              stroke="none"
                              opacity="@segmentNodeOpacity.I()" />
                        @if (segSelected)
                        {
                            <path d="@segment.MorphPath" fill="rgba(255,215,0,0.18)" stroke="#FFD700" stroke-width="@(2.5 / _zoom)" stroke-linejoin="round" />
                        }
                    </g>
                }
            </g>



            <circle cx="0" cy="0" r="@CenterHubRadius.I()" fill="#0d0d1a" />
        </g>

        @if (keySubdivisionIndex >= 0)
        {
            var centerLabelSize = 15.5 / _zoom;
            @SvgText(0, 0, centerLabelSize,
                "fill:#f5f5f5;font-family:'Helvetica Neue',sans-serif;font-weight:900;letter-spacing:0.02em;pointer-events:none",
                SubdivisionRootLabel(keySubdivisionIndex))
        }

        @if (TryBuildScaleDegreeLabels(out var scaleDegreeLabels))
        {
            var degreeLabelSize = 11.5 / _zoom;
            foreach (var degree in scaleDegreeLabels)
            {
                var (degreeX, degreeY) = RotatePoint(degree.X, degree.Y, graphRotationDegrees);
                @SvgText(degreeX, degreeY, degreeLabelSize,
                    "fill:#f5f5f5;font-family:'Helvetica Neue',sans-serif;font-weight:800;letter-spacing:0.03em;pointer-events:none;opacity:0.92",
                    degree.Text)
            }
        }

        @if (surfaceLabelOpacity > 0.001)
        {
            var baseLabelSize = 13.5 / _zoom;
            foreach (var label in BuildSurfaceLabels(segments))
            {
                var isSelected = IsSubdivisionSelected(label.SubdivisionIndex);
                var isKeyLabel = label.SubdivisionIndex == keySubdivisionIndex;
                var labelFill = "#111111";
                var labelSize = isSelected ? baseLabelSize * 1.22 : baseLabelSize;
                var (labelX, labelY) = RotatePoint(label.X, label.Y, graphRotationDegrees);
                @SvgText(labelX, labelY, labelSize,
                    $"fill:{labelFill};font-family:'Helvetica Neue',sans-serif;font-weight:800;letter-spacing:0.01em;pointer-events:none;opacity:{surfaceLabelOpacity.I()}",
                    label.Text)
            }
        }

        @if (overtoneLabelOpacity > 0.001)
        {
            var baseLabelSize = 8.5 / _zoom;
            foreach (var segment in segments)
            {
                var isSelected = IsSegmentSelected(segment.SubdivisionIndex, segment.Cycle);
                var isKeySegment = segment.SubdivisionIndex == keySubdivisionIndex;
                var labelFill = "#111111";
                var labelSize = isSelected ? baseLabelSize * 1.22 : baseLabelSize;
                var (labelX, labelY) = RotatePoint(segment.MidX, segment.MidY, graphRotationDegrees);
                @SvgText(labelX, labelY, labelSize,
                    $"fill:{labelFill};font-family:'Helvetica Neue',sans-serif;font-weight:700;pointer-events:none;opacity:{overtoneLabelOpacity.I()}",
                    segment.Label)
            }
        }
    </svg>

    <div class="spiral-right-panel-stack" aria-label="Scale and note analysis panels">
        <section class="spiral-instrument-overlay-panel" aria-label="Current scale on guitar and piano">
            <h2>Scale overlay</h2>
            @{
                var overlaySemitones = GetInstrumentOverlaySemitones();
                var overlayRoot = GetOverlayRootSemitone();
                var hasSelectedOverlayPositionRange = TryGetSelectedOverlayPositionRange(out var overlayPositionStartFret, out var overlayPositionEndFret);
            }

            @if (overlaySemitones.Count == 0)
            {
                <p class="spiral-instrument-overlay-empty">Select notes or choose a key + scale to view instrument overlays.</p>
            }
            else
            {
                <div class="spiral-instrument-overlay-stack">
                    <div class="spiral-instrument-overlay-card">
                        <h3>Guitar fretboard</h3>
                        <svg viewBox="0 0 330 120" class="spiral-mini-fretboard" role="img" aria-label="Selected notes on guitar fretboard">
                            <rect x="0" y="0" width="330" height="120" rx="8" fill="#4b2b16" />

                            @for (var fret = 0; fret <= OverlayFretCount; fret++)
                            {
                                var x = 20 + fret * 24;
                                var isNut = fret == 0;
                                <line x1="@x" y1="14" x2="@x" y2="106" stroke="@(isNut ? "#e8e8c8" : "#c0a060")" stroke-width="@(isNut ? 4 : 1.2)" />
                            }

                            @for (var stringIndex = 0; stringIndex < StandardGuitarOpenSemitones.Length; stringIndex++)
                            {
                                var y = 22 + stringIndex * 16;
                                <line x1="20" y1="@y" x2="308" y2="@y" stroke="#d4c078" stroke-width="@(1.0 + (5 - stringIndex) * 0.2)" />

                                for (var fret = 0; fret <= OverlayFretCount; fret++)
                                {
                                    var semitone = (StandardGuitarOpenSemitones[stringIndex] + fret) % 12;
                                    if (!overlaySemitones.Contains(semitone))
                                    {
                                        continue;
                                    }

                                    if (hasSelectedOverlayPositionRange
                                        && (fret < overlayPositionStartFret || fret > overlayPositionEndFret))
                                    {
                                        continue;
                                    }

                                    var cx = fret == 0 ? 10 : 20 + (fret - 0.5) * 24;
                                    var isRoot = overlayRoot >= 0 && semitone == overlayRoot;
                                    <circle cx="@cx" cy="@y" r="5.2" fill="@(isRoot ? "#ffd700" : "#ffffff")" opacity="@(isRoot ? "0.98" : "0.72")" />
                                }
                            }
                        </svg>

                        @if (TryGetSelectedScaleDegrees(out var overlayScaleDegrees))
                        {
                            <div class="spiral-overlay-position-row" role="group" aria-label="Fretboard scale positions">
                                <button class="spiral-overlay-position-btn @(_selectedOverlayScaleDegree is null ? "active" : null)"
                                        @onclick="() => SelectOverlayScalePosition(null)">
                                    all
                                </button>
                                @foreach (var position in overlayScaleDegrees)
                                {
                                    var degree = position.Degree;
                                    <button class="spiral-overlay-position-btn @(_selectedOverlayScaleDegree == degree ? "active" : null)"
                                            @onclick="() => SelectOverlayScalePosition(degree)">
                                        @RomanNumeral(position.Degree)
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="spiral-instrument-overlay-card">
                        <h3>Piano keyboard</h3>
                        <svg viewBox="0 0 330 108" class="spiral-mini-keys" role="img" aria-label="Selected notes on piano keyboard">
                            <rect x="0" y="0" width="330" height="108" rx="8" fill="#1b1b2e" />

                            @for (var i = 0; i < PianoWhiteSemitones.Length; i++)
                            {
                                var whiteSemitone = PianoWhiteSemitones[i];
                                var x = 10 + i * 22;
                                var isSelected = overlaySemitones.Contains(whiteSemitone);
                                var fill = isSelected ? "#ffd700" : "#ffffff";
                                <rect x="@x" y="12" width="22" height="86" fill="@fill" stroke="#171717" stroke-width="0.8" />
                            }

                            @for (var i = 0; i < PianoBlackKeys.Length; i++)
                            {
                                var blackKey = PianoBlackKeys[i];
                                var isSelected = overlaySemitones.Contains(blackKey.Semitone);
                                var fill = isSelected ? "#ffd700" : "#111111";
                                <rect x="@blackKey.X" y="12" width="14" height="54" rx="2" fill="@fill" stroke="#050505" stroke-width="0.8" />
                            }
                        </svg>

                        @if (TryGetSelectedScaleStepPattern(out var stepPattern))
                        {
                            <div class="spiral-step-pattern" aria-label="Scale whole and half step pattern">
                                <span class="spiral-step-pattern-label">Steps</span>
                                <div class="spiral-step-pattern-chips">
                                    @foreach (var step in stepPattern)
                                    {
                                        <span class="spiral-step-chip">@step</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>

        <aside class="spiral-note-pool-panel" aria-label="Selected note pool">
            <h2>Stage 1 · Note pool</h2>

        @if (_selectedNotes.Count == 0)
        {
            <p class="spiral-note-pool-empty">Click a note slice to add it to the pool.</p>
        }
        else
        {
            var noteProfiles = BuildNotePoolProfiles();
            <ul class="spiral-note-pool-list">
                @foreach (var noteProfile in noteProfiles)
                {
                    <li style="font-size:@noteProfile.FontSizeRem.I()rem; opacity:@noteProfile.VisualOpacity.I(); color:@noteProfile.AccentColor">
                        <span>@noteProfile.Label</span>
                        @if (_selectedNotes.Count > 1)
                        {
                            <small>@noteProfile.HarmonyToDissonanceRatio ratio</small>
                        }
                    </li>
                }
            </ul>

            @if (_selectedNotes.Count == 1)
            {
                <p class="spiral-note-pool-next">Select one more note to analyze the diad relationship.</p>
            }
            else if (_selectedNotes.Count == 2)
            {
                var diad = BuildDiadAnalysis(_selectedNotes[0], _selectedNotes[1]);
                <div class="spiral-diad-panel" aria-label="Diad relationship metrics">
                    <h3>Diad</h3>

                    <div class="spiral-diad-graph" aria-label="Proportional line graph">
                        <div class="spiral-diad-graph-line">
                            <span class="spiral-diad-graph-segment"
                                  style="width:@diad.LeftLinePercent.I()%; background:@diad.LeftColor"
                                  title="@diad.LeftLabel proportion"></span>
                            <span class="spiral-diad-graph-segment"
                                  style="width:@diad.RightLinePercent.I()%; background:@diad.RightColor"
                                  title="@diad.RightLabel proportion"></span>
                        </div>
                        <div class="spiral-diad-graph-labels">
                            <span style="color:@diad.LeftColor">@diad.LeftLabel @diad.LeftLinePercent.I()%</span>
                            <span style="color:@diad.RightColor">@diad.RightLabel @diad.RightLinePercent.I()%</span>
                        </div>
                    </div>

                    <dl>
                        <div>
                            <dt>Notes</dt>
                            <dd>@diad.LeftLabel + @diad.RightLabel</dd>
                        </div>
                        <div>
                            <dt>Interval distance</dt>
                            <dd>@diad.IntervalSemitones semitones</dd>
                        </div>
                        <div>
                            <dt>Circle distance</dt>
                            <dd>@diad.FifthDistance steps</dd>
                        </div>
                        <div>
                            <dt>Harmony / Dissonance</dt>
                            <dd>@diad.HarmonyPercent / @diad.DissonancePercent</dd>
                        </div>
                        <div>
                            <dt>Ratio</dt>
                            <dd>@diad.HarmonyToDissonanceRatio</dd>
                        </div>
                        <div>
                            <dt>Mood</dt>
                            <dd><span class="spiral-diad-mood" style="--mood-color:@diad.MoodColor">@diad.MoodLabel</span></dd>
                        </div>
                    </dl>
                </div>
            }
            else if (_selectedNotes.Count == 3)
            {
                var triad = BuildTriadAnalysis(_selectedNotes);
                <div class="spiral-triad-panel" aria-label="Triad relationship metrics">
                    <h3>Triad</h3>
                    <dl>
                        <div>
                            <dt>Notes</dt>
                            <dd>@triad.NotesLabel</dd>
                        </div>
                        <div>
                            <dt>Pair harmony</dt>
                            <dd>@triad.HarmonyPercent / @triad.DissonancePercent</dd>
                        </div>
                        <div>
                            <dt>Ratios</dt>
                            <dd>@triad.PairRatios</dd>
                        </div>
                        <div>
                            <dt>Quality</dt>
                            <dd><span class="spiral-diad-mood" style="--mood-color:@triad.QualityColor">@triad.QualityLabel</span></dd>
                        </div>
                    </dl>
                </div>
            }
            else
            {
                <p class="spiral-note-pool-next">Each note is sized and colored by its harmony:dissonance relationship to the rest of the pool.</p>
            }

            <div class="spiral-scale-panel" aria-label="Scale ideas based on selected notes">
                <h3>Scale ideas</h3>
                @if (ScaleIdeas.Count == 0)
                {
                    <p class="spiral-note-pool-next">Select at least one note to see compatible scales.</p>
                }
                else
                {
                    <ul class="spiral-scale-list">
                        @foreach (var scale in ScaleIdeas)
                        {
                            <li>
                                <span>@scale.Label</span>
                                <small>@scale.MatchSummary</small>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="spiral-progression-panel" aria-label="Branching chord progression paths">
                <h3>Progression paths</h3>
                @if (CurrentExplorationChord is null)
                {
                    <p class="spiral-note-pool-next">Select at least 3 notes to infer a chord and see branching next moves.</p>
                }
                else
                {
                    <p class="spiral-progression-current">Current chord: <strong>@CurrentExplorationChord.DisplayName</strong></p>

                    @if (ProgressionPaths.Count == 0)
                    {
                        <p class="spiral-note-pool-next">No nearby progression branches found yet.</p>
                    }
                    else
                    {
                        <div class="spiral-progression-paths">
                            @foreach (var path in ProgressionPaths)
                            {
                                <section class="spiral-progression-branch">
                                    <h4>@path.Title</h4>
                                    <ul>
                                        @foreach (var move in path.Moves)
                                        {
                                            <li>
                                                <button class="spiral-progression-chip" @onclick="() => ApplyProgressionMoveAsync(move)">
                                                    <span>@move.Chord.DisplayName</span>
                                                    <small>@move.Relationship</small>
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </section>
                            }
                        </div>
                    }
                }
            </div>

            @if (SelectedSubdivisionIndices().Count < SubdivisionCount)
            {
                var nextMoves = BuildNextMoveRecommendations();
                <div class="spiral-next-moves-panel" aria-label="Mood directed next moves">
                    <h3>Next moves</h3>
                    <p class="spiral-next-moves-target">Toward <strong>@MoodTargetLabel(SelectedMoodTarget)</strong></p>

                    @if (nextMoves.Count == 0)
                    {
                        <p class="spiral-note-pool-next">Add at least one note to see recommendations.</p>
                    }
                    else
                    {
                        <ul class="spiral-next-moves-list">
                            @foreach (var move in nextMoves)
                            {
                                <li>
                                    <span>@move.NoteLabel</span>
                                    <small>@move.ResultMoodLabel · @move.ProgressPercent</small>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        }
        </aside>
    </div>

    <section class="spiral-foundation-panel" aria-label="Current foundation concepts">
        <h1>Fretless</h1>
        <p>Fully zoomed out notes read as solid slices; zoom in to reveal their overtone layers.</p>
    </section>
</div>

@code {
    private const double SpiralA = 20.0;
    private const double SpiralB = 46.0;
    private const double FreqZ = SpiralB / (2.0 * Math.PI);
    private const int SpiralTurns = 8;
    private const double SurfaceBandThickness = 10.0;
    private const double ZoomedArcThickness = 24.0;
    private const double GapArcLength = 6.0;
    private const double CenterHubRadius = SpiralA * 0.72;
    private const double CenterGapWidth = GapArcLength;
    private const double OvertoneLevelGap = GapArcLength;
    private const double FullyZoomedOutZoom = 0.50;
    private const double OvertoneLayerRevealEndZoom = 0.95;
    private const double SurfaceTransitionStartZoom = 0.95;
    private const double SurfaceTransitionEndZoom = 1.35;
    private const int MinSubdivisionCount = 3;
    private const int MaxSubdivisionCount = 48;

    private static readonly string[] TwelveToneLabels =
    [
        "C", "Db", "D", "Eb", "E", "F", "F#", "G", "Ab", "A", "Bb", "B"
    ];

    private static readonly string[] AvailableKeys = TwelveToneLabels;
    private static readonly string[] AvailableScaleNames =
    [
        "Chromatic",
        "Major",
        "Natural Minor",
        "Major Pentatonic",
        "Minor Pentatonic",
        "Blues",
        "Dorian",
        "Mixolydian",
        "Lydian",
        "Phrygian",
        "Harmonic Minor",
        "Melodic Minor",
        "Locrian"
    ];
    private static readonly MoodTarget[] AvailableMoodTargets = Enum.GetValues<MoodTarget>();
    private static readonly int[] StandardGuitarOpenSemitones = [4, 9, 2, 7, 11, 4];
    private static readonly int[] PianoWhiteSemitones = [0, 2, 4, 5, 7, 9, 11, 0, 2, 4, 5, 7, 9, 11];
    private static readonly (double X, int Semitone)[] PianoBlackKeys =
    [
        (26, 1),
        (48, 3),
        (92, 6),
        (114, 8),
        (136, 10),
        (180, 1),
        (202, 3),
        (246, 6),
        (268, 8),
        (290, 10),
    ];
    private const int OverlayFretCount = 12;
    private const int OverlayPositionSpanFrets = 4;

    private string _selectedKey = "";
    private string _selectedScale = "";
    private string SelectedKey
    {
        get => _selectedKey;
        set
        {
            if (_selectedKey != value)
            {
                _selectedKey = value;
                _selectedOverlayScaleDegree = null;
                _targetGraphRotationDegrees = CalculateGraphRotationDegrees();
                _ = AnimateGraphRotationAsync();
            }
        }
    }

    private string SelectedScale
    {
        get => _selectedScale;
        set
        {
            if (_selectedScale != value)
            {
                _selectedScale = value;
                _selectedOverlayScaleDegree = null;
                StateHasChanged();
            }
        }
    }

    private int? _selectedOverlayScaleDegree;

    private HashSet<int>? GetSelectedScaleNotes()
    {
        if (string.IsNullOrEmpty(_selectedScale))
        {
            return null;
        }

        var keySemitone = string.IsNullOrEmpty(_selectedKey)
            ? 0
            : KeyLabelToChromaticSemitone(_selectedKey);
        if (keySemitone < 0)
        {
            return null;
        }

        var scale = CommonScales.FirstOrDefault(s => s.Name == _selectedScale);
        if (scale is null)
        {
            return null;
        }

        var scaleNotes = new HashSet<int>();
        
        foreach (var interval in scale.Intervals)
        {
            scaleNotes.Add((keySemitone + interval) % 12);
        }

        return scaleNotes;
    }

    private bool IsNoteOutsideSelectedScale(int subdivisionIndex)
    {
        if (string.IsNullOrEmpty(_selectedScale))
        {
            return false;
        }

        var scaleNotes = GetSelectedScaleNotes();
        if (scaleNotes is null)
        {
            return false;
        }

        var noteSemitone = ToChromaticSemitone(subdivisionIndex);
        return !scaleNotes.Contains(noteSemitone);
    }

    private bool TryBuildScaleDegreeLabels(out IReadOnlyList<ScaleDegreeLabel> labels)
    {
        labels = [];

        if (string.IsNullOrWhiteSpace(_selectedKey) || string.IsNullOrWhiteSpace(_selectedScale))
        {
            return false;
        }

        var keySemitone = KeyLabelToChromaticSemitone(_selectedKey);
        if (keySemitone < 0)
        {
            return false;
        }

        var scale = CommonScales.FirstOrDefault(s => s.Name == _selectedScale);
        if (scale is null || scale.Intervals.Length == 0)
        {
            return false;
        }

        var outerRadius = SpiralA + SpiralTurns * SpiralB + SpiralB / 2.0;
        var labelRadius = outerRadius + 16.0;
        var slot = 2.0 * Math.PI / SubdivisionCount;
        var degreeLabels = new List<ScaleDegreeLabel>(scale.Intervals.Length);

        for (var i = 0; i < scale.Intervals.Length; i++)
        {
            var semitone = (keySemitone + scale.Intervals[i]) % 12;
            var subdivisionIndex = ToSubdivisionFromSemitone(semitone);
            var midAngle = (subdivisionIndex + 0.5) * slot;
            var (x, y) = PolarPoint(midAngle, labelRadius);
            degreeLabels.Add(new ScaleDegreeLabel(x, y, RomanNumeral(i + 1)));
        }

        labels = degreeLabels;
        return true;
    }

    private static string RomanNumeral(int value) => value switch
    {
        1 => "i",
        2 => "ii",
        3 => "iii",
        4 => "iv",
        5 => "v",
        6 => "vi",
        7 => "vii",
        8 => "viii",
        9 => "ix",
        10 => "x",
        11 => "xi",
        12 => "xii",
        _ => value.ToString()
    };

