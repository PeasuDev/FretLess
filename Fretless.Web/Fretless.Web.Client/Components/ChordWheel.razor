@using Fretless.Web.Client.Models
@inject IJSRuntime JS
@inject MidiService Midi
@implements IAsyncDisposable

<div class="chord-wheel-container">
    <div class="chord-wheel-svg-wrapper">
        @{
            var selectedCofIdx = SelectedNote is null ? -1 : Array.IndexOf(MusicTheoryService.CircleOfFifths, SelectedNote);
            var keyRoles = selectedCofIdx >= 0
                ? MusicTheoryService.GetKeyRelationships(selectedCofIdx)
                : null;
        }
        <NoteCircleView SelectedNote="SelectedNote"
                        KeyRoles="keyRoles"
                        MidiActiveSemitones="_midiActiveSemitones"
                        ShowComplementary="@(ActiveChord is not null)"
                        OnNoteClicked="SelectNote" />
    </div>

    @if (ActiveChord is not null)
    {
        <div class="chord-info" style="border-color: @MusicTheoryService.MoodColor(ActiveChord.Type.Mood)">
            <span class="chord-name" style="color: @MusicTheoryService.MoodColor(ActiveChord.Type.Mood)">
                @ActiveChord.DisplayName
            </span>
            <span class="chord-type-name">@ActiveChord.Type.Name</span>
            <span class="chord-desc">@ActiveChord.Type.Description</span>
            <button class="play-btn" @onclick="PlayActiveChord">▶ Play</button>
        </div>
    }

    @if (SelectedNote is not null)
    {
        var cofIdx = Array.IndexOf(MusicTheoryService.CircleOfFifths, SelectedNote);
        if (cofIdx >= 0)
        {
            var diatonic = MusicTheoryService.GetDiatonicChords(cofIdx);
            var primary   = diatonic.Where(d => d.Role.Priority <= 2).ToList();
            var secondary = diatonic.Where(d => d.Role.Priority > 2).ToList();

            <div class="diatonic-panel">
                <div class="diatonic-panel-header">
                    <span class="diatonic-panel-title">Chords in the key of <strong>@MusicTheoryService.DisplayName(SelectedNote)</strong></span>
                    <span class="diatonic-panel-hint">Tap a card to hear it</span>
                </div>

                <div class="diatonic-group">
                    <span class="diatonic-group-label">Primary — the backbone of the key</span>
                    <div class="diatonic-cards">
                        @foreach (var d in primary)
                        {
                            var isActive = ActiveChord?.DisplayName == d.Chord.DisplayName;
                            <button class="diatonic-card @(isActive ? "diatonic-card--active" : "")"
                                    style="--role-color:@d.Role.Color"
                                    @onclick="() => SelectChord(d.Chord)">
                                <span class="diatonic-card-roman">@d.Role.Roman</span>
                                <span class="diatonic-card-name">@d.Chord.DisplayName</span>
                                <span class="diatonic-card-type">@d.Chord.Type.Name</span>
                                <span class="diatonic-card-desc">@d.ScaleDegreeDescription</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="diatonic-group">
                    <span class="diatonic-group-label">Secondary — add colour and movement</span>
                    <div class="diatonic-cards">
                        @foreach (var d in secondary)
                        {
                            var isActive = ActiveChord?.DisplayName == d.Chord.DisplayName;
                            <button class="diatonic-card @(isActive ? "diatonic-card--active" : "")"
                                    style="--role-color:@d.Role.Color"
                                    @onclick="() => SelectChord(d.Chord)">
                                <span class="diatonic-card-roman">@d.Role.Roman</span>
                                <span class="diatonic-card-name">@d.Chord.DisplayName</span>
                                <span class="diatonic-card-type">@d.Chord.Type.Name</span>
                                <span class="diatonic-card-desc">@d.ScaleDegreeDescription</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public EventCallback<NoteChord?> OnChordSelected { get; set; }

    private string? SelectedNote { get; set; }
    private NoteChord? ActiveChord { get; set; }
    private readonly HashSet<int> _midiActiveSemitones = [];

    private void SelectNote(string note)
    {
        SelectedNote = SelectedNote == note ? null : note;
        ActiveChord = null;
        OnChordSelected.InvokeAsync(null);
    }

    private async Task SelectChord(NoteChord chord)
    {
        ActiveChord = ActiveChord?.DisplayName == chord.DisplayName ? null : chord;
        await OnChordSelected.InvokeAsync(ActiveChord);
        if (ActiveChord is not null)
            await PlayActiveChord();
    }

    private async Task PlayActiveChord()
    {
        if (ActiveChord is null) return;
        var notes = ActiveChord.AbsoluteNotes
            .Select(n => $"{MusicTheoryService.NoteAtIndex(n)}4")
            .ToArray();
        await JS.InvokeVoidAsync("fretlessAudio.playChord", (object)notes);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Midi.NoteOn  += OnMidiNoteOn;
            Midi.NoteOff += OnMidiNoteOff;
            await Midi.InitAsync(JS);
        }
    }

    private void OnMidiNoteOn(int midi)
    {
        _midiActiveSemitones.Add(midi % 12);
        InvokeAsync(StateHasChanged);
    }

    private void OnMidiNoteOff(int midi)
    {
        _midiActiveSemitones.Remove(midi % 12);
        InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        Midi.NoteOn  -= OnMidiNoteOn;
        Midi.NoteOff -= OnMidiNoteOff;
        return ValueTask.CompletedTask;
    }
}
