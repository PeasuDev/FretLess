@using Fretless.Web.Client.Models
@inject IJSRuntime JS

<div class="chord-wheel-container">
    <div class="chord-wheel-svg-wrapper">
    <svg viewBox="-1 -1 2 2"
         xmlns="http://www.w3.org/2000/svg"
         class="chord-wheel"
         role="img"
         aria-label="Fretless chord wheel">

        @* Outer ring: circle of fifths note segments *@
        @{
            var selectedCofIdx = SelectedNote is null ? -1 : Array.IndexOf(MusicTheoryService.CircleOfFifths, SelectedNote);
            var keyRoles = selectedCofIdx >= 0
                ? MusicTheoryService.GetKeyRelationships(selectedCofIdx)
                : null;
        }
        @foreach (var (note, i) in MusicTheoryService.CircleOfFifths.Select((n, i) => (n, i)))
        {
            var isSelected = SelectedNote == note;
            var isComplementary = ActiveChord is not null && i == ComplementaryNoteIndex;
            var role = keyRoles?.GetValueOrDefault(i);
            var isDiatonic = role is not null;
            var isNonDiatonic = keyRoles is not null && !isDiatonic;

            var segClass = isSelected ? "selected" : isComplementary ? "complementary" : isDiatonic ? "diatonic" : "";
            var path = OuterArcPath(i, 12, OuterR, InnerR);
            var labelPos = ArcMidpoint(i, 12, (OuterR + InnerR) / 2.0);
            var rolePos  = ArcMidpoint(i, 12, OuterR - 0.06);

            // Fill: selected=white, role color if diatonic, default hue if not
            var fill = isSelected ? "#ffffff"
                     : isDiatonic ? role!.Color
                     : NoteSegmentColor(i);
            var opacity = isSelected || isComplementary ? "1"
                        : isDiatonic ? "0.95"
                        : isNonDiatonic ? "0.22"
                        : "0.82";
            var stroke = isComplementary ? "#ff6ec7" : "#1a1a2e";
            var strokeW = isComplementary ? "0.018" : "0.008";

            <g class="note-segment @segClass"
               @onclick="() => SelectNote(note)"
               style="cursor:pointer">
                <path d="@path"
                      fill="@fill"
                      stroke="@stroke"
                      stroke-width="@strokeW"
                      opacity="@opacity" />
                @SvgText(labelPos.X, labelPos.Y, "0.065",
                    $"fill:{(isSelected ? "#1a1a2e" : "#ffffff")};pointer-events:none;font-family:'Helvetica Neue',sans-serif;font-weight:bold",
                    MusicTheoryService.DisplayName(note))
                @if (isDiatonic && !isSelected)
                {
                    @SvgText(rolePos.X, rolePos.Y, "0.042",
                        "fill:#ffffff;pointer-events:none;font-family:'Helvetica Neue',sans-serif;font-weight:600;opacity:0.9",
                        role!.Roman)
                }
            </g>
        }

        @* Inner ring: only shown when a note is selected — single solid ring as visual anchor *@
        @if (SelectedNote is not null)
        {
            var noteIdx = Array.IndexOf(MusicTheoryService.CircleOfFifths, SelectedNote);
            var path = OuterArcPath(noteIdx, 12, InnerR, CentreR + 0.02);
            <path d="@path" fill="rgba(255,255,255,0.04)" stroke="#ffffff" stroke-width="0.003" opacity="0.3" />
        }


    </svg>
    </div>

    @if (ActiveChord is not null)
    {
        <div class="chord-info" style="border-color: @MusicTheoryService.MoodColor(ActiveChord.Type.Mood)">
            <span class="chord-name" style="color: @MusicTheoryService.MoodColor(ActiveChord.Type.Mood)">
                @ActiveChord.DisplayName
            </span>
            <span class="chord-type-name">@ActiveChord.Type.Name</span>
            <span class="chord-desc">@ActiveChord.Type.Description</span>
            <button class="play-btn" @onclick="PlayActiveChord">▶ Play</button>
        </div>
    }

    @if (SelectedNote is not null)
    {
        var cofIdx = Array.IndexOf(MusicTheoryService.CircleOfFifths, SelectedNote);
        if (cofIdx >= 0)
        {
            var diatonic = MusicTheoryService.GetDiatonicChords(cofIdx);
            var primary   = diatonic.Where(d => d.Role.Priority <= 2).ToList();
            var secondary = diatonic.Where(d => d.Role.Priority > 2).ToList();

            <div class="diatonic-panel">
                <div class="diatonic-panel-header">
                    <span class="diatonic-panel-title">Chords in the key of <strong>@MusicTheoryService.DisplayName(SelectedNote)</strong></span>
                    <span class="diatonic-panel-hint">Tap a card to hear it</span>
                </div>

                <div class="diatonic-group">
                    <span class="diatonic-group-label">Primary — the backbone of the key</span>
                    <div class="diatonic-cards">
                        @foreach (var d in primary)
                        {
                            var isActive = ActiveChord?.DisplayName == d.Chord.DisplayName;
                            <button class="diatonic-card @(isActive ? "diatonic-card--active" : "")"
                                    style="--role-color:@d.Role.Color"
                                    @onclick="() => SelectChord(d.Chord)">
                                <span class="diatonic-card-roman">@d.Role.Roman</span>
                                <span class="diatonic-card-name">@d.Chord.DisplayName</span>
                                <span class="diatonic-card-type">@d.Chord.Type.Name</span>
                                <span class="diatonic-card-desc">@d.ScaleDegreeDescription</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="diatonic-group">
                    <span class="diatonic-group-label">Secondary — add colour and movement</span>
                    <div class="diatonic-cards">
                        @foreach (var d in secondary)
                        {
                            var isActive = ActiveChord?.DisplayName == d.Chord.DisplayName;
                            <button class="diatonic-card @(isActive ? "diatonic-card--active" : "")"
                                    style="--role-color:@d.Role.Color"
                                    @onclick="() => SelectChord(d.Chord)">
                                <span class="diatonic-card-roman">@d.Role.Roman</span>
                                <span class="diatonic-card-name">@d.Chord.DisplayName</span>
                                <span class="diatonic-card-type">@d.Chord.Type.Name</span>
                                <span class="diatonic-card-desc">@d.ScaleDegreeDescription</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public EventCallback<NoteChord?> OnChordSelected { get; set; }

    private string? SelectedNote { get; set; }
    private NoteChord? ActiveChord { get; set; }

    // Index of the note diametrically opposite on the circle of fifths (6 steps = tritone away).
    // Returns -1 when no chord is active or the selected note is not on the circle.
    private int ComplementaryNoteIndex
    {
        get
        {
            if (ActiveChord is null || SelectedNote is null) return -1;
            var idx = Array.IndexOf(MusicTheoryService.CircleOfFifths, SelectedNote);
            return idx < 0 ? -1 : (idx + 6) % 12;
        }
    }

    private const double OuterR = 0.96;
    private const double InnerR = 0.56;
    private const double CentreR  = 0.13;   // must match the centre <circle> r
    private const double RingGap   = 0.006;  // radial gap between rings

    private void SelectNote(string note)
    {
        SelectedNote = SelectedNote == note ? null : note;
        ActiveChord = null;
        OnChordSelected.InvokeAsync(null);
    }

    private async Task SelectChord(NoteChord chord)
    {
        ActiveChord = ActiveChord?.DisplayName == chord.DisplayName ? null : chord;
        await OnChordSelected.InvokeAsync(ActiveChord);
        if (ActiveChord is not null)
            await PlayActiveChord();
    }

    private async Task PlayActiveChord()
    {
        if (ActiveChord is null) return;
        var notes = ActiveChord.AbsoluteNotes
            .Select(n => $"{MusicTheoryService.NoteAtIndex(n)}4")
            .ToArray();
        await JS.InvokeVoidAsync("fretlessAudio.playChord", (object)notes);
    }

    private static string NoteSegmentColor(int index)
    {
        return MusicTheoryService.NoteColor(index, saturation: 55, lightness: 38);
    }

    private static string OuterArcPath(int segIndex, int total, double rOuter, double rInner)
    {
        var gap = 0.018; // radians gap between segments
        var startAngle = segIndex * (2 * Math.PI / total) - Math.PI / 2 + gap / 2;
        var endAngle = (segIndex + 1) * (2 * Math.PI / total) - Math.PI / 2 - gap / 2;

        var x1 = Math.Cos(startAngle) * rOuter;
        var y1 = Math.Sin(startAngle) * rOuter;
        var x2 = Math.Cos(endAngle) * rOuter;
        var y2 = Math.Sin(endAngle) * rOuter;
        var x3 = Math.Cos(endAngle) * rInner;
        var y3 = Math.Sin(endAngle) * rInner;
        var x4 = Math.Cos(startAngle) * rInner;
        var y4 = Math.Sin(startAngle) * rInner;

        var largeArc = (endAngle - startAngle > Math.PI) ? 1 : 0;

        return $"M {x1.I()} {y1.I()} " +
               $"A {rOuter.I()} {rOuter.I()} 0 {largeArc} 1 {x2.I()} {y2.I()} " +
               $"L {x3.I()} {y3.I()} " +
               $"A {rInner.I()} {rInner.I()} 0 {largeArc} 0 {x4.I()} {y4.I()} Z";
    }

    private static (double X, double Y) ArcMidpoint(int segIndex, int total, double r)
    {
        var mid = (segIndex + 0.5) * (2 * Math.PI / total) - Math.PI / 2;
        return (Math.Cos(mid) * r, Math.Sin(mid) * r);
    }

    private static MarkupString SvgText(double x, double y, string fontSize, string style, string? content) =>
        new($"<text x=\"{x.I()}\" y=\"{y.I()}\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"{fontSize}\" style=\"{style}\">{System.Text.Encodings.Web.HtmlEncoder.Default.Encode(content ?? string.Empty)}</text>");
}
