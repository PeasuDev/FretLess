@using Fretless.Web.Client.Models

<div class="mood-legend" role="group" aria-label="Mood filter">
    @foreach (var (mood, color) in MusicTheoryService.MoodColors)
    {
        var isActive = ActiveFilter == mood;
        <MoodChip Mood="mood" Color="color" Active="isActive" OnToggle="() => ToggleFilter(mood)" />
    }
</div>

@code {
    [Parameter] public ChordMood? ActiveFilter { get; set; }
    [Parameter] public EventCallback<ChordMood?> ActiveFilterChanged { get; set; }

    private async Task ToggleFilter(ChordMood mood)
    {
        var next = ActiveFilter == mood ? (ChordMood?)null : mood;
        await ActiveFilterChanged.InvokeAsync(next);
    }
}
