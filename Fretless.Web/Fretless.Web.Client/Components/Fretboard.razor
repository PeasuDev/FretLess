@using Fretless.Web.Client.Models
@inject IJSRuntime JS
@inject MidiService Midi
@inject AudioInputNoteService AudioInput
@implements IAsyncDisposable

<div class="fretboard-container">
    <div class="fretboard-header">
        <span class="fretboard-label">@(Tuning?.Name ?? "Standard") — @StringCount strings</span>
        <TuningSelector Tuning="@(Tuning ?? TuningService.Standard)" TuningChanged="TuningChanged" Inline="true" />
    </div>
    <div class="fretboard-scale-row">
        <ScaleSelector @bind-ActiveOverlay="InternalScale" />
    </div>

    @* Position selector for scale degrees *@
    @if (InternalScale is not null)
    {
        <PositionPill Label="Position:">
            <RomanNumeralButton Numeral="All"
                                Active="@(SelectedPosition == null)"
                                OnClick="() => SelectPosition(null)" />
            @foreach (var (degree, index) in GetScaleDegrees())
            {
                if (index == 7) continue;

                var degreeCapture = degree;
                <RomanNumeralButton Numeral="@GetRomanNumeral(index)"
                                    Active="@(SelectedPosition == degree)"
                                    OnClick="() => SelectPosition(degreeCapture)" />
            }
        </PositionPill>
    }

    <div class="fretboard-audio-row">
        <button class="fretboard-audio-mute" @onclick="ToggleMute" aria-label="Toggle mute">@(_isMuted ? "Unmute" : "Mute")</button>
        <label class="fretboard-audio-label" for="fretboard-volume">Volume</label>
        <input id="fretboard-volume"
               class="fretboard-volume-slider"
               type="range"
               min="0"
               max="1"
               step="0.01"
               value="@_volume"
               @oninput="OnVolumeInput" />
        <span class="fretboard-volume-value">@((int)Math.Round(_volume * 100))%</span>
    </div>


    <FretboardView Tuning="ActiveTuning"
                   FretCount="FretCount"
                   HighlightedSemitones="@ScaleHighlights"
                   RootSemitone="@(InternalScale?.RootIndex)"
                   MidiActiveSemitones="@(_activeInputNotes.Count > 0 ? ActiveInputNoteIndexes : null)"
                   MidiActiveStyleFor="@(_activeInputNotes.Count > 0 ? (Func<int, (string, string)>)(noteIdx => (PlayingIndicatorStroke(noteIdx), PlayingIndicatorFill(noteIdx, 0.25))) : null)"
                   ManualDots="@(InternalScale is null ? _manualDotPairs : null)"
                   ChordDots="@ChordDotsForView"
                   ChordColor="@ChordOverlayColor"
                   OpenMutedStrings="@OpenMutedForView"
                   OnFretClicked="HandleFretClicked"
                   OnStringShifted="HandleStringShifted" />

    @if (ActiveChord is not null)
    {
        <div class="fretboard-legend">
            @foreach (var dot in ChordDots.DistinctBy(d => d.NoteIndex))
            {
                <span class="legend-note"
                      style="background:@MusicTheoryService.MoodColor(ActiveChord.Type.Mood)">
                    @MusicTheoryService.NoteAtIndex(dot.NoteIndex)
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public NoteChord? ActiveChord { get; set; }
    [Parameter] public TuningPreset? Tuning { get; set; }
    [Parameter] public EventCallback<TuningPreset> TuningChanged { get; set; }

    private ScaleOverlay? InternalScale { get; set; }
    private int? SelectedPosition { get; set; }
    private readonly HashSet<(int S, int F)> _manualDots = [];
    private double _volume = 0.72;
    private bool _isMuted;
    private readonly Dictionary<int, ActiveInputNote> _activeInputNotes = [];

    private TuningPreset ActiveTuning => Tuning ?? TuningService.Standard;
    private const int FretCount = 12;

    private int StringCount => ActiveTuning.StringCount;
    private int[] OpenStringNotes => ActiveTuning.MidiNotes;

    // The primitive's ManualDots type matches the parent's _manualDots set element shape
    // (int StringIndex, int Fret); reuse the same set for the view.
    private IReadOnlyCollection<(int StringIndex, int Fret)> _manualDotPairs =>
        _manualDots.Select(d => (d.S, d.F)).ToArray();

    private IReadOnlyCollection<int>? ScaleHighlights
    {
        get
        {
            if (InternalScale is null) return null;
            if (SelectedPosition.HasValue)
            {
                return InternalScale.NoteSet.Contains(SelectedPosition.Value)
                    ? new[] { SelectedPosition.Value }
                    : Array.Empty<int>();
            }
            return InternalScale.NoteSet.ToArray();
        }
    }

    private IReadOnlyList<(int StringIndex, int Fret, int NoteIndex)>? ChordDotsForView =>
        ActiveChord is null
            ? null
            : ChordDots.Select(d => (d.StringIndex, d.Fret, d.NoteIndex)).ToList();

    private IReadOnlyList<(string Symbol, int StringIndex)>? OpenMutedForView =>
        ActiveChord is null ? null : OpenMuted.ToList();

    private string? ChordOverlayColor =>
        ActiveChord is null ? null : MusicTheoryService.MoodColor(ActiveChord.Type.Mood);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Midi.NoteOn  += OnMidiNoteOn;
            Midi.NoteOff += OnMidiNoteOff;
            AudioInput.NoteOn += OnAudioInputNoteOn;
            AudioInput.NoteOff += OnAudioInputNoteOff;
            await Midi.InitAsync(JS);
        }
    }

    private void OnMidiNoteOn(int midi) => AddActiveInputNote(midi, InputNoteSource.Midi);

    private void OnMidiNoteOff(int midi) => RemoveActiveInputNote(midi);

    private void OnAudioInputNoteOn(int midi) => AddActiveInputNote(midi, InputNoteSource.Audio);

    private void OnAudioInputNoteOff(int midi) => RemoveActiveInputNote(midi);

    private void AddActiveInputNote(int midi, InputNoteSource source)
    {
        _activeInputNotes[midi] = new ActiveInputNote(midi, source, DateTimeOffset.UtcNow);
        InvokeAsync(StateHasChanged);
    }

    private void RemoveActiveInputNote(int midi)
    {
        if (_activeInputNotes.Remove(midi, out var activeNote))
        {
            _ = DateTimeOffset.UtcNow - activeNote.StartedAt;
        }

        InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        Midi.NoteOn  -= OnMidiNoteOn;
        Midi.NoteOff -= OnMidiNoteOff;
        AudioInput.NoteOn -= OnAudioInputNoteOn;
        AudioInput.NoteOff -= OnAudioInputNoteOff;
        return ValueTask.CompletedTask;
    }

    private HashSet<int> ActiveInputNoteIndexes => _activeInputNotes.Keys
        .Select(static midi => midi % 12)
        .ToHashSet();

    private record FretDot(int StringIndex, int Fret, int NoteIndex);

    private enum InputNoteSource
    {
        Midi,
        Audio
    }

    private sealed record ActiveInputNote(int Midi, InputNoteSource Source, DateTimeOffset StartedAt);

    private NoteChord? _cachedChord;
    private TuningPreset? _cachedChordTuning;
    private IReadOnlyList<FretDot> _cachedChordDots = [];
    private IReadOnlyList<(string Symbol, int StringIndex)> _cachedOpenMuted = [];

    private void EnsureChordCacheCurrent()
    {
        if (ActiveChord is null)
        {
            if (_cachedChord is not null)
            {
                _cachedChord = null;
                _cachedChordTuning = null;
                _cachedChordDots = [];
                _cachedOpenMuted = [];
            }
            return;
        }

        var tuning = ActiveTuning;
        if (ReferenceEquals(_cachedChord, ActiveChord) && ReferenceEquals(_cachedChordTuning, tuning))
        {
            return;
        }

        _cachedChord = ActiveChord;
        _cachedChordTuning = tuning;
        _cachedChordDots = BuildChordDots(ActiveChord);
        _cachedOpenMuted = BuildOpenMuted(ActiveChord);
    }

    private IReadOnlyList<FretDot> ChordDots
    {
        get { EnsureChordCacheCurrent(); return _cachedChordDots; }
    }

    private IReadOnlyList<(string Symbol, int StringIndex)> OpenMuted
    {
        get { EnsureChordCacheCurrent(); return _cachedOpenMuted; }
    }

    private IReadOnlyList<FretDot> BuildChordDots(NoteChord chord)
    {
        var chordNotes = chord.AbsoluteNotes.ToHashSet();
        var dots = new List<FretDot>();
        for (int s = 0; s < StringCount; s++)
        {
            for (int f = 0; f <= FretCount; f++)
            {
                var noteIdx = (OpenStringNotes[s] + f) % 12;
                if (chordNotes.Contains(noteIdx))
                {
                    dots.Add(new FretDot(s, f == 0 ? 0 : f, noteIdx));
                    break;
                }
            }
        }
        return dots;
    }

    private IReadOnlyList<(string, int)> BuildOpenMuted(NoteChord chord)
    {
        var chordNotes = chord.AbsoluteNotes.ToHashSet();
        var result = new List<(string, int)>();
        for (int s = 0; s < StringCount; s++)
        {
            var openNote = OpenStringNotes[s] % 12;
            if (!chordNotes.Contains(openNote))
                result.Add(("✕", s));
        }
        return result;
    }

    private async Task HandleFretClicked((int StringIndex, int Fret) e)
    {
        var (s, f) = e;
        if (s < 0 || s >= StringCount || f < 0 || f > FretCount) return;

        if (InternalScale is not null)
        {
            // Scale mode: only respond when the click lands on a scale-note position
            // (further filtered by SelectedPosition if set).
            var noteIdx = (OpenStringNotes[s] + f) % 12;
            if (!InternalScale.NoteSet.Contains(noteIdx)) return;
            if (SelectedPosition.HasValue && noteIdx != SelectedPosition.Value) return;
            await PlayMidi(OpenStringNotes[s] + f);
            return;
        }

        // No scale active: toggle the manual dot and play the note.
        await ToggleManualDot(s, f);
    }

    private async Task HandleStringShifted((int StringIndex, int Semitones) e)
    {
        await ShiftString(e.StringIndex, e.Semitones);
    }

    private async Task ToggleManualDot(int s, int f)
    {
        var key = (s, f);
        if (!_manualDots.Remove(key))
            _manualDots.Add(key);
        await PlayMidi(OpenStringNotes[s] + f);
    }

    private async Task ShiftString(int stringIndex, int semitones)
    {
        var notes = ActiveTuning.MidiNotes.ToArray();
        notes[stringIndex] = Math.Clamp(notes[stringIndex] + semitones, TuningService.MinAudibleMidi, TuningService.MaxAudibleMidi);
        var updated = new TuningPreset("Custom", notes);
        await TuningChanged.InvokeAsync(updated);
    }

    private async Task PlayMidi(int midi)
    {
        var clampedMidi = Math.Clamp(midi, TuningService.MinAudibleMidi, TuningService.MaxAudibleMidi);
        var noteName = TuningService.MidiLabel(clampedMidi);
        await JS.InvokeVoidAsync("fretlessAudio.playNote", noteName);
    }

    private string PlayingIndicatorStroke(int noteIndex) => InternalScale is null
        ? "#ffffff"
        : InternalScale.NoteSet.Contains(noteIndex) ? "#36d66b" : "#ff4d4d";

    private string PlayingIndicatorFill(int noteIndex, double alpha) => InternalScale is null
        ? $"rgba(255,255,255,{alpha.ToInvariant()})"
        : InternalScale.NoteSet.Contains(noteIndex) ? $"rgba(54,214,107,{alpha.ToInvariant()})" : $"rgba(255,77,77,{alpha.ToInvariant()})";

    private async Task OnVolumeInput(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), out var volume))
        {
            return;
        }

        _volume = Math.Clamp(volume, 0.0, 1.0);
        await JS.InvokeVoidAsync("fretlessAudio.setMasterVolume", _volume);
    }

    private async Task ToggleMute()
    {
        _isMuted = !_isMuted;
        await JS.InvokeVoidAsync("fretlessAudio.setMuted", _isMuted);
    }

    private void SelectPosition(int? degree)
    {
        SelectedPosition = degree;
    }

    private List<(int degree, int index)> GetScaleDegrees()
    {
        if (InternalScale is null) return new();

        var degrees = new List<(int degree, int index)>();
        var orderedNotes = InternalScale.NoteSet
            .OrderBy(n => (n - InternalScale.RootIndex + 12) % 12)
            .ToList();

        for (int i = 0; i < orderedNotes.Count; i++)
        {
            degrees.Add((orderedNotes[i], i + 1));
        }

        return degrees;
    }

    private string GetRomanNumeral(int index)
    {
        return index switch
        {
            1 => "i",
            2 => "ii",
            3 => "iii",
            4 => "iv",
            5 => "v",
            6 => "vi",
            7 => "vii",
            8 => "viii",
            _ => index.ToString()
        };
    }
}
