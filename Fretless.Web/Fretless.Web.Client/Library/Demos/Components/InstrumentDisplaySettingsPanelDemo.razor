@namespace Fretless.Web.Client.Library.Demos.Components

<LibraryFrame Title="InstrumentDisplaySettingsPanel"
              Description="Settings panel used by SpiralWheel instrument overlay cards for note-name and fret-number visibility toggles."
              SourcePath="Fretless.Web/Fretless.Web.Client/Components/InstrumentDisplaySettingsPanel.razor">

    <Variants>
        <div class="variant-card">
            <h3 class="variant-card__label">Guitar display settings</h3>
            <div class="variant-card__render">
                <InstrumentDisplaySettingsPanel ShowNoteNames="true" ShowFretNumbersOption="true" />
            </div>
            <pre class="variant-card__code"><code>&lt;InstrumentDisplaySettingsPanel ShowNoteNames="true" ShowFretNumbersOption="true" /&gt;</code></pre>
        </div>

        <div class="variant-card">
            <h3 class="variant-card__label">Piano display settings</h3>
            <div class="variant-card__render">
                <InstrumentDisplaySettingsPanel ShowNoteNames="true" />
            </div>
            <pre class="variant-card__code"><code>&lt;InstrumentDisplaySettingsPanel ShowNoteNames="true" /&gt;</code></pre>
        </div>
    </Variants>
</LibraryFrame>
