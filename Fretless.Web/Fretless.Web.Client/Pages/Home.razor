@page "/"
@using Fretless.Web.Client.Models
@using Fretless.Web.Client.Components
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Fretless</PageTitle>

<div class="fretless-layout">

    @* Full-viewport spiral — sits behind everything *@
    <div class="wheel-layer">
        <SpiralWheel OnChordSelected="OnChordSelected" HighlightChord="@ActiveChord" />
    </div>

    @* Floating header top-left *@
    <header class="fretless-header">
        <h1 class="site-title">Fretless</h1>
        <p class="site-subtitle">Circle of Fifths</p>
    </header>

    @* Floating right-side panel *@
    <aside class="legend-section">
        <ChordPairings ActiveChord="@ActiveChord" ChordSelected="OnChordSelected" />
    </aside>

    @* Fretboard minimized toggle — visible only when collapsed *@
    @if (FretboardCollapsed)
    {
        <button class="fretboard-toggle-btn"
                aria-label="Show fretboard"
                title="Show fretboard"
                @onclick="ToggleFretboard">
            @* Guitar body SVG icon *@
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="32" height="32" aria-hidden="true">
                <ellipse cx="24" cy="32" rx="11" ry="12" fill="#8B5E3C" stroke="#C0A060" stroke-width="1.5"/>
                <ellipse cx="24" cy="32" rx="6.5" ry="7" fill="#5C3317" opacity="0.5"/>
                <circle cx="24" cy="32" r="2.5" fill="#C0A060"/>
                <rect x="22.5" y="4" width="3" height="20" rx="1.5" fill="#8B5E3C" stroke="#C0A060" stroke-width="1"/>
                <rect x="18" y="4" width="12" height="4" rx="2" fill="#5C3317" stroke="#C0A060" stroke-width="1"/>
                @foreach (var pct in new[] { 0.25, 0.5, 0.75 })
                {
                    <line x1="@((22.5).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                          y1="@((4 + pct * 20).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                          x2="@((25.5).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                          y2="@((4 + pct * 20).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                          stroke="#C0A060" stroke-width="0.75" />
                }
            </svg>
        </button>
    }

    @* Floating bottom panel *@
    <section class="fretboard-section @(FretboardCollapsed ? "fretboard-section--collapsed" : "")"
             style="@(FretboardCollapsed ? "" : $"height: {FretboardHeight}px")">
        <div class="fretboard-resize-handle"
             role="separator"
             aria-label="@(FretboardCollapsed ? "Show fretboard" : "Drag to resize or click to minimize fretboard")"
             aria-orientation="horizontal"
             tabindex="0"
             @onmousedown="OnResizeMouseDown"
             @ontouchstart="OnResizeTouchStart">
            <button class="fretboard-minimize-btn"
                    aria-label="@(FretboardCollapsed ? "Show fretboard" : "Minimize fretboard")"
                    title="@(FretboardCollapsed ? "Show fretboard" : "Minimize")"
                    @onclick="ToggleFretboard"
                    @onclick:stopPropagation="true">
                @if (FretboardCollapsed)
                {
                    <span>&#9650;</span>
                }
                else
                {
                    @* Guitar body SVG icon *@
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="18" height="18" aria-hidden="true">
                        <ellipse cx="24" cy="32" rx="11" ry="12" fill="#8B5E3C" stroke="#C0A060" stroke-width="1.5"/>
                        <circle cx="24" cy="32" r="2.5" fill="#C0A060"/>
                        <rect x="22.5" y="4" width="3" height="20" rx="1.5" fill="#8B5E3C" stroke="#C0A060" stroke-width="1"/>
                        <rect x="18" y="4" width="12" height="4" rx="2" fill="#5C3317" stroke="#C0A060" stroke-width="1"/>
                    </svg>
                }
            </button>
        </div>
        @if (!FretboardCollapsed)
        {
            <Fretboard ActiveChord="@ActiveChord" Tuning="@CurrentTuning" TuningChanged="OnTuningChanged" />
        }
    </section>

</div>

@code {
    private NoteChord? ActiveChord { get; set; }
    private TuningPreset CurrentTuning { get; set; } = TuningService.Standard;

    private void OnChordSelected(NoteChord? chord) => ActiveChord = chord;
    private void OnTuningChanged(TuningPreset tuning) => CurrentTuning = tuning;

    // ── Fretboard collapse / expand ────────────────────────
    private bool FretboardCollapsed { get; set; } = false;

    private void ToggleFretboard() => FretboardCollapsed = !FretboardCollapsed;

    // ── Fretboard vertical resize ───────────────────────────
    private const int FretboardMinHeight = 120;
    private const int FretboardMaxHeight = 600;
    private int FretboardHeight { get; set; } = 220;

    private double _resizeStartY;
    private int _resizeStartHeight;
    private DotNetObjectReference<Home>? _dotNetRef;

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    private async Task OnResizeMouseDown(MouseEventArgs e)
    {
        _resizeStartY = e.ClientY;
        _resizeStartHeight = FretboardHeight;
        await JS.InvokeVoidAsync("fretlessResizeStart", _dotNetRef);
    }

    private async Task OnResizeTouchStart(TouchEventArgs e)
    {
        _resizeStartY = e.Touches[0].ClientY;
        _resizeStartHeight = FretboardHeight;
        await JS.InvokeVoidAsync("fretlessResizeStart", _dotNetRef);
    }

    [JSInvokable]
    public void OnResizeMove(double clientY)
    {
        var delta = (int)(_resizeStartY - clientY);
        FretboardHeight = Math.Clamp(_resizeStartHeight + delta, FretboardMinHeight, FretboardMaxHeight);
        StateHasChanged();
    }

    public void Dispose() => _dotNetRef?.Dispose();
}
